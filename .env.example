# URL base de la API.
# En desarrollo, "/api" usa el proxy de Vite (vite.config.js) hacia el gateway.
# En producción (Vercel) debe ser la URL absoluta del backend con HTTPS,
# por ejemplo: https://api.tu-dominio.com/api
VITE_API_URL=/api

# URL del servidor Socket.IO. Si se omite, el cliente no abre el socket.
# En producción, apunta al backend que soporte WebSocket (no Vercel).
# VITE_WS_URL=https://api.tu-dominio.com
