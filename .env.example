# URL base de la API.
# Con "/api" el cliente usa el proxy de Vite (vite.config.js) hacia el gateway.
# Con una URL absoluta se salta el proxy (requiere CORS en el backend).
VITE_API_URL=/api

# URL del servidor Socket.IO. En desarrollo, Vite reenvía /socket.io al
# gateway; en producción apunta al dominio público que expone el gateway.
# VITE_WS_URL=http://localhost:3000
