# URL base de la API.
# Con "/api" el cliente usa el proxy de Vite (vite.config.js) hacia el gateway.
# Con una URL absoluta se salta el proxy (requiere CORS en el backend).
VITE_API_URL=/api

# URL del servidor Socket.IO (opcional).
# Si se omite, el cliente no abre el socket (el mock y Vercel no lo exponen).
# VITE_WS_URL=http://localhost:3005
